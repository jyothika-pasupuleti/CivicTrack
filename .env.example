# Copy this file to .env and replace both local passwords/keys.
CIVICTRACK_DATABASE_URL=mysql+pymysql://civictrack:change-this-local-password@127.0.0.1:3306/civictrack
CIVICTRACK_SECRET_KEY=replace-with-a-random-secret
CIVICTRACK_UPLOAD_DIR=data/uploads
CIVICTRACK_COOKIE_SECURE=false
CIVICTRACK_MAX_UPLOAD_BYTES=5242880
CIVICTRACK_TOKEN_EXPIRY_MINUTES=720
